/** 全局基础样式：卡片、按钮、提示等通用类。 */

page {
  background: #f5f6f8;
  color: #1f2937;
  font-size: 28rpx;
  line-height: 1.6;
}

.page {
  padding: 24rpx 24rpx 64rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.hint {
  font-size: 24rpx;
  color: #6b7280;
}

.muted {
  color: #6b7280;
}

.primary-btn {
  background: #0f766e;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 2.6;
  margin-top: 24rpx;
}

.primary-btn[disabled] {
  background: #9ca3af;
  color: #ffffff;
}

.plain-btn {
  background: #ecfdf5;
  color: #0f766e;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 2.4;
  margin-top: 20rpx;
}

.danger-btn {
  background: #fef2f2;
  color: #b91c1c;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 2.4;
  margin-top: 20rpx;
}

.row {
  display: flex;
  align-items: center;
}

.gap {
  height: 24rpx;
}

.divider {
  height: 1rpx;
  background: #eef0f3;
  margin: 20rpx 0;
}

.input {
  background: #f8f9fb;
  border: 2rpx solid #e5e7eb;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
}

.tag {
  display: inline-block;
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}

.tag-pass {
  background: #ecfdf5;
  color: #047857;
}

.tag-issue {
  background: #fef2f2;
  color: #b91c1c;
}

.tag-unknown {
  background: #f3f4f6;
  color: #4b5563;
}
