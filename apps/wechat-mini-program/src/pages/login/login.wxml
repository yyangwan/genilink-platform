<view class="page">
  <view class="card">
    <view class="card-title">登录智链</view>

    <block wx:if="{{step === 'wechat'}}">
      <view class="hint">授权后，未注册的手机号将开通智链账号。你可以用同一账号在电脑上查看报告。</view>
      <view class="agree-row">
        <checkbox-group bindchange="onWechatAgreement">
          <label class="agree-text"><checkbox value="accepted" checked="{{agreeTerms && agreePrivacy}}" color="#0f766e" />我已阅读并同意智链服务条款和隐私政策</label>
        </checkbox-group>
      </view>
      <view class="hint small">智链协议：genilink.cn/terms 和 genilink.cn/privacy</view>
      <text class="link small" bindtap="onOpenWechatPrivacy">查看微信小程序隐私保护指引</text>
      <button class="primary-btn" open-type="getPhoneNumber" bindgetphonenumber="onWechatPhone"
        loading="{{confirming}}" disabled="{{sending || confirming || !wechatPhoneEnabled || !agreeTerms || !agreePrivacy}}">
        微信手机号一键注册
      </button>
      <button class="plain-btn" bindtap="onUseSms" disabled="{{sending || confirming}}">使用短信验证</button>
    </block>

    <block wx:elif="{{step === 'phone'}}">
      <view class="hint">{{pairing ? '验证要关联到原账号的手机号。' : '使用你的手机号登录已有账号，或开通智链账号。'}}</view>
      <view class="gap"></view>
      <input class="input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
      <button class="primary-btn" bindtap="onSend" loading="{{sending}}" disabled="{{sending}}">获取验证码</button>
      <button class="plain-btn" wx:if="{{wechatPhoneEnabled}}" bindtap="onUseWechat" disabled="{{sending}}">返回微信一键注册</button>
    </block>

    <!-- 第 2 步：验证码 -->
    <block wx:elif="{{step === 'code'}}">
      <view class="hint">验证码已发送至 {{phone}}</view>
      <view class="gap"></view>
      <view class="code-row">
        <input class="input code-input" type="number" maxlength="6" placeholder="短信验证码" value="{{code}}" bindinput="onCodeInput" />
        <view class="resend" wx:if="{{countdown > 0}}">{{countdown}}s 后可重发</view>
        <view class="resend active" wx:else bindtap="onResend">重新发送</view>
      </view>
      <button class="primary-btn" bindtap="onVerify" loading="{{verifying}}" disabled="{{verifying}}">验证</button>
      <view class="hint small">收不到短信？请检查号码是否正确，稍后再试或更换号码。</view>
    </block>

    <!-- 第 3 步：确认 -->
    <block wx:elif="{{step === 'confirm'}}">
      <view class="confirm-line">手机号：<text class="strong">{{maskedPhone}}</text></view>
      <view class="confirm-line" wx:if="{{pairing}}">确认将已验证的手机号与电脑端配对的智链账号关联。</view>
      <view class="confirm-line" wx:elif="{{needTerms}}">
        该手机号尚未注册，验证后将<text class="strong">创建新账号</text>。
      </view>
      <view class="confirm-line" wx:else>该手机号已有账号，验证后将与此微信绑定并登录。</view>

      <!-- 显式同意控件：未勾选时确认按钮不可用 -->
      <view class="divider" wx:if="{{needTerms}}"></view>
      <view class="agree-row" wx:if="{{needTerms}}" bindtap="onToggleTerms">
        <view class="checkbox {{agreeTerms ? 'checked' : ''}}">{{agreeTerms ? '✓' : ''}}</view>
        <view class="agree-text">我已阅读并同意<text class="link">《服务条款》</text>（版本 {{termsVersion}}）</view>
      </view>
      <view class="agree-row" wx:if="{{needTerms}}" bindtap="onTogglePrivacy">
        <view class="checkbox {{agreePrivacy ? 'checked' : ''}}">{{agreePrivacy ? '✓' : ''}}</view>
        <view class="agree-text">我已阅读并同意<text class="link">《隐私政策》</text>（版本 {{privacyVersion}}）</view>
      </view>
      <view class="hint small" wx:if="{{needTerms}}">创建账号前需同时勾选以上两项。完整文本可在浏览器查看 genilink.cn/terms 和 genilink.cn/privacy。</view>

      <button
        class="primary-btn"
        bindtap="onConfirm"
        loading="{{confirming}}"
        disabled="{{confirming || (needTerms && (!agreeTerms || !agreePrivacy))}}"
      >
        {{needTerms ? '同意并创建账号' : '确认绑定并登录'}}
      </button>
    </block>

    <view class="error" role="alert" wx:if="{{errorText}}">{{errorText}}</view>
    <button class="plain-btn" wx:if="{{!pairing && (step === 'wechat' || step === 'phone')}}" bindtap="onGoPair" disabled="{{sending || confirming}}">关联已有账号 · 扫码配对</button>
  </view>
</view>
