# Database — PostgreSQL with connection pooling
DATABASE_URL="postgresql://user:password@localhost:5432/genilink?connection_limit=15&pool_timeout=10"

# Auth (NextAuth v5)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# SMS provider: tencent | aliyun (no automatic retry across providers)
SMS_PROVIDER="aliyun"
# Optional; falls back to AUTH_SECRET. Use a separate random secret in production.
SMS_CODE_SECRET=""

# Tencent Cloud SMS — positional template values: code,ttl
TENCENTCLOUD_SECRET_ID=""
TENCENTCLOUD_SECRET_KEY=""
TENCENTCLOUD_SMS_SDK_APP_ID=""
TENCENTCLOUD_SMS_SIGN_NAME=""
TENCENTCLOUD_SMS_TEMPLATE_ID=""
# Comma-separated template variables: code,ttl (default: code)
TENCENTCLOUD_SMS_TEMPLATE_PARAMS="code"
TENCENTCLOUD_SMS_REGION="ap-guangzhou"

# Alibaba Cloud SMS — named template values, commonly code or code,ttl
ALIBABA_CLOUD_ACCESS_KEY_ID=""
ALIBABA_CLOUD_ACCESS_KEY_SECRET=""
ALIBABA_CLOUD_SMS_SIGN_NAME=""
ALIBABA_CLOUD_SMS_TEMPLATE_CODE=""
ALIBABA_CLOUD_SMS_TEMPLATE_PARAMS="code"
ALIBABA_CLOUD_SMS_ENDPOINT="dysmsapi.aliyuncs.com"

# Alibaba Cloud billing notification templates (notification SMS, not verification SMS)
ALIBABA_CLOUD_SMS_TEMPLATE_PHONE_CHANGE=""
ALIBABA_CLOUD_SMS_TEMPLATE_SUBSCRIPTION_ACTIVATED=""
ALIBABA_CLOUD_SMS_TEMPLATE_RENEWAL_DUE=""
ALIBABA_CLOUD_SMS_TEMPLATE_SUBSCRIPTION_EXPIRED=""
ALIBABA_CLOUD_SMS_TEMPLATE_GRACE_ENDING=""
ALIBABA_CLOUD_SMS_TEMPLATE_RENEWAL_SUCCESS=""

# WeChat MP (服务号) for QR code login
WECHAT_MP_APPID=""
WECHAT_MP_SECRET=""
WECHAT_MP_TOKEN=""

# Federation service URLs
VISIBILITY_SERVICE_URL="https://genilink.cn/visibility"
CONTENT_SERVICE_URL="http://127.0.0.1:4003"

# Public app URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Billing plans (amounts use the currency's smallest unit)
BILLING_CURRENCY="CNY"
BILLING_LITE_MONTHLY_CENTS="9900"
BILLING_LITE_YEARLY_CENTS="99900"
BILLING_PRO_MONTHLY_CENTS="39900"
BILLING_PRO_YEARLY_CENTS="399900"
BILLING_MAX_MONTHLY_CENTS="129900"
BILLING_MAX_YEARLY_CENTS="1299900"

# Billing / WeChat Pay
WECHATPAY_APP_ID=""
WECHATPAY_MCH_ID=""
WECHATPAY_MCH_SERIAL_NO=""
WECHATPAY_MCH_PRIVATE_KEY=""
WECHATPAY_PLATFORM_CERT_PEM=""
WECHATPAY_API_V3_KEY=""
WECHATPAY_NOTIFY_URL="https://genilink.cn/api/billing/webhooks/wechatpay"

# Billing / WeChat Pay recurring (委托代扣) — OFF until merchant approval (spec §22)
WECHATPAY_RECURRING_ENABLED="false"
WECHATPAY_CONTRACT_TEMPLATE_ID=""
WECHATPAY_CONTRACT_NOTIFY_URL=""

# Billing / Alipay
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""
ALIPAY_NOTIFY_URL="https://genilink.cn/api/billing/webhooks/alipay"
ALIPAY_GATEWAY_URL="https://openapi.alipay.com/gateway.do"

# Billing / Alipay recurring (周期扣款) — OFF until merchant approval (spec §22)
ALIPAY_RECURRING_ENABLED="false"
ALIPAY_AGREEMENT_PRODUCT_CODE=""
ALIPAY_AGREEMENT_NOTIFY_URL=""

# Billing / checkout & auto-renewal internals
BILLING_CRON_SECRET=""
BILLING_CHECKOUT_TTL_MINUTES="30"
BILLING_GRACE_PERIOD_DAYS="7"

# Billing / promotions seeded on startup (spec §7). JSON array, e.g.:
# BILLING_PROMOTION_SEEDS='[{"name":"首年8折","discountType":"percentage","discountValue":2000,"duration":"once","startsAt":"2026-08-01T00:00:00.000Z","maxPerUser":1,"coupons":[{"code":"WELCOME20"}]}]'
BILLING_PROMOTION_SEEDS=""
