{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.genilink.cn/content-platform-capabilities-v1.schema.json",
  "title": "ContentPlatformCapabilitiesV1",
  "description": "GeniLink 跨服务契约：ContentOS 内容生成平台能力声明。第一版仅开放已实现的四个平台。冻结于 docs/zhijian-to-zhichuang-content-workflow-design.md v1.0 §10.9。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "platforms"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "platforms": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1, "maxLength": 32 },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enabled"],
        "properties": {
          "enabled": { "type": "boolean" },
          "reason": { "type": "string", "maxLength": 200 },
          "maxConcurrent": { "type": "integer", "minimum": 1, "maximum": 16 }
        }
      }
    }
  }
}
