{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.genilink.cn/content-workflow-v1.schema.json",
  "title": "ContentWorkflowV1",
  "description": "GeniLink 跨服务契约：内容创建工作流（Portal 预占额度后调用 ContentOS 创建，含 usageOperationId 对账关联）。冻结于 docs/zhijian-to-zhichuang-content-workflow-design.md v1.0 §9-10。",
  "$ref": "#/$defs/createWorkflowRequestV1",
  "$defs": {
    "platformEnum": {
      "enum": ["wechat", "weibo", "xiaohongshu", "douyin"]
    },
    "createWorkflowRequestV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["briefId", "briefRevision", "platforms", "usageOperationId"],
      "properties": {
        "briefId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "briefRevision": { "type": "integer", "minimum": 1 },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/platformEnum" }
        },
        "templateId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "brandVoiceId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "usageOperationId": {
          "type": "string",
          "maxLength": 191,
          "pattern": "^content-workflow:[^:]{1,64}:[0-9a-f]{64}$"
        }
      }
    },
    "platformRunViewV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "status"],
      "properties": {
        "platform": { "type": "string", "minLength": 1, "maxLength": 32 },
        "status": {
          "enum": [
            "queued",
            "generating",
            "succeeded",
            "failed_retryable",
            "failed_terminal",
            "cancelled"
          ]
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "maxLength": 64 },
            "message": { "type": "string", "maxLength": 2000 }
          }
        },
        "attemptCount": { "type": "integer", "minimum": 0 }
      }
    },
    "workflowViewV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "briefId", "briefRevision", "status", "platforms"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "briefId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "briefRevision": { "type": "integer", "minimum": 1 },
        "contentPieceId": { "type": ["string", "null"], "maxLength": 64 },
        "status": {
          "enum": ["queued", "generating", "succeeded", "partial", "failed", "cancelled"]
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/platformRunViewV1" }
        }
      }
    }
  }
}
