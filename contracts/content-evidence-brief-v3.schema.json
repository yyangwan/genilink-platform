        "scope": {
          "maxLength": 1000,
          "minLength": 5,
          "title": "Scope",
          "type": "string"
        },
        "validFrom": {
          "format": "date-time",
          "title": "Validfrom",
          "type": "string"
        },
        "validUntil": {
          "format": "date-time",
          "title": "Validuntil",
          "type": "string"
        },
        "source": {
          "discriminator": {
            "mapping": {
              "citation_review": "#/$defs/CitationReviewSource",
              "owned_asset_revision": "#/$defs/OwnedAssetSource"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CitationReviewSource"
            },
            {
              "$ref": "#/$defs/OwnedAssetSource"
            }
          ],
          "title": "Source"
        },
        "referenceUrl": {
          "anyOf": [
            {
              "maxLength": 4096,
              "pattern": "^https?://",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Referenceurl"
        }
      },
      "required": [
        "id",
        "version",
        "ownTargetId",
        "statement",
        "scope",
        "validFrom",
        "validUntil",
        "source"
