{
  "$defs": {
    "AITarget": {
      "additionalProperties": false,
      "properties": {
        "platform": {
          "enum": [
            "deepseek",
            "qwen",
            "doubao",
            "kimi",
            "hunyuan"
          ],
          "title": "Platform",
          "type": "string"
        },
        "promptHash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Prompthash",
          "type": "string"
        },
        "prompt": {
          "maxLength": 400000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "scenarioId": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Scenarioid",
          "type": "string"
        },
        "dimensions": {
          "items": {
            "enum": [
              "presence",
              "recommendation",
              "position",
              "reasons"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Dimensions",
          "type": "array"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Observations",
          "type": "array"
        }
      },
      "required": [
        "platform",
        "promptHash",
        "prompt",
        "scenarioId",
        "dimensions",
        "observations"
      ],
      "title": "AITarget",
      "type": "object"
    },
