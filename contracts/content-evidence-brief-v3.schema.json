    "DeliverySpec": {
      "additionalProperties": false,
      "properties": {
        "asset_title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Asset Title",
          "type": "string"
        },
        "asset_kind": {
          "enum": [
            "existing_material",
            "new_deliverable"
          ],
          "title": "Asset Kind",
          "type": "string"
        },
        "material_revision_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material Revision Id"
        },
        "material_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material Version"
        },
        "reference_url": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Url"
        },
        "audience": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Audience",
          "type": "array"
        },
        "audience_status": {
          "enum": [
            "reviewed_prompt",
            "unknown"
          ],
          "title": "Audience Status",
          "type": "string"
        },
        "outline": {
          "items": {
            "maxLength": 2000,
            "minLength": 5,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 2,
          "title": "Outline",
          "type": "array"
        },
        "channel": {
          "enum": [
            "own_website",
            "material_library",
            "reference_publisher"
          ],
          "title": "Channel",
          "type": "string"
        },
        "channel_reason": {
          "maxLength": 2000,
          "minLength": 5,
          "title": "Channel Reason",
          "type": "string"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/TaskQuestion"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Questions",
          "type": "array"
        }
      },
      "required": [
        "asset_title",
        "asset_kind",
        "audience_status",
        "outline",
        "channel",
        "channel_reason",
        "questions"
      ],
      "title": "DeliverySpec",
      "type": "object"
    },
    "DiagnosticContext": {
      "additionalProperties": false,
