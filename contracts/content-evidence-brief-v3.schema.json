        "quote": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "project_id",
        "owner_kind",
        "owner_id",
        "text_hash",
        "quote",
        "start",
        "end"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
