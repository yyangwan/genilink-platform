          "maxItems": 100,
          "title": "Counterevidence",
          "type": "array"
        },
        "use": {
          "const": "diagnostic_only",
          "default": "diagnostic_only",
          "enum": [
            "diagnostic_only"
          ],
          "title": "Use",
          "type": "string"
        }
      },
      "title": "DiagnosticContext",
      "type": "object"
